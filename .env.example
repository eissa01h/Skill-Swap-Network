# ========================================================
# Skill Swap Network - Master Environment Variables Example
# ========================================================
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL!
# Copy this template to create your local .env or configure in cloud dashboards.

# --------------------------------------------------------
# 1. Frontend Configuration (Cloudflare Pages / Local)
# --------------------------------------------------------
# Local: /api/v1 (using Vite proxy to localhost:8080)
# Cloudflare Pages Production: https://skill-swap-network-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --------------------------------------------------------
# 2. Backend Server Configuration (Render / Local)
# --------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --------------------------------------------------------
# 3. PostgreSQL Database (Supabase Free Tier / Local)
# --------------------------------------------------------
# Local default:
DB_URL=jdbc:postgresql://localhost:5432/skill_swap_network
DB_USERNAME=postgres
DB_PASSWORD=your_local_password_here

# Supabase Production example:
# DB_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=your_supabase_database_password

# --------------------------------------------------------
# 4. JWT Security Configuration
# --------------------------------------------------------
# Must be at least 256 bits (32 bytes) hex-encoded for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# --------------------------------------------------------
# 5. CORS Allowed Client Origin
# --------------------------------------------------------
# Local: http://localhost:5173
# Cloudflare Pages Production: https://skill-swap-network.pages.dev
CLIENT_ORIGIN=http://localhost:5173
